#--------------------------------------------------------------------
# Red Ciudadana de Talentos — Ejemplo de configuración (.env.example)
# Copiar a .env y ajustar valores reales en el servidor.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'America/Mexico_City'

#--------------------------------------------------------------------
# BASE DE DATOS (MariaDB 10.5)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = rct_activistas
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# CIFRADO EN REPOSO Y HASH PEPPER (LFPDPPP)
# Generar con: php spark key:generate
#--------------------------------------------------------------------
encryption.key =
RCT_HASH_PEPPER = cambiar-por-pepper-aleatorio-en-produccion

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
RCT_CORS_ALLOWED_ORIGINS = 'https://activistas.solytecmx.com,http://localhost:5173,http://localhost:5174'

#--------------------------------------------------------------------
# GOOGLE CLOUD (Servidor: Vision API + Geocoding API)
#--------------------------------------------------------------------
GOOGLE_MAPS_SERVER_KEY =
GOOGLE_VISION_API_KEY =
GOOGLE_APPLICATION_CREDENTIALS =
