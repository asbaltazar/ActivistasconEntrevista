# .htaccess raíz en public_html/ (PWA App Activista — https://activistas.solytecmx.com/)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS en producción
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloquear cualquier acceso web directo a la carpeta privada backend/ (.env, writable/uploads, etc.)
    RewriteRule ^backend(/.*)?$ - [F,L]

    # No interceptar rutas del Panel ni de la API REST
    RewriteRule ^panel(/.*)?$ - [L]
    RewriteRule ^api(/.*)?$ - [L]

    # Servir archivos estáticos existentes (JS, CSS, manifest, sw.js)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback SPA para Vue Router (modo history)
    RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

